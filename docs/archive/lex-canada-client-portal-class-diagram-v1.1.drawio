<mxCell id="title1" value="LEX CANADA LAW — CLIENT PORTAL — CLASS DIAGRAM (v1.1)&lt;br&gt;Architecture retenue : Solution 1 — Next.js (Azure App Service) + Supabase (Auth, PostgreSQL, RLS, jobs planifiés) + Clio Manage API (région Canada) + Microsoft Graph / SharePoint" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0F1B3C;fontColor=#FFFFFF;strokeColor=none;fontSize=16;fontStyle=1;align=left;spacing=10;" vertex="1" parent="1">
  <mxGeometry x="40" y="-140" width="1620" height="80" as="geometry" />
</mxCell>
<mxCell id="legend1" value="Légende : rectangles pleins = entités de domaine (1:1 avec supabase/schema.sql). &lt;&lt;interface&gt;&gt; = abstraction d'intégration (PaymentProvider, SignatureProvider, NotificationProvider). ClioManageClient / SharePointClient = classes serveur uniquement, jamais appelées depuis le navigateur." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F5F7;fontColor=#0F1B3C;strokeColor=#C9A227;fontSize=11;align=left;spacing=8;" vertex="1" parent="1">
