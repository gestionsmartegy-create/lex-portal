-- ============================================================================
-- Jeu d'essai commun aux tests pgTAP (inclus par \ir dans chaque *.test.sql).
-- Extension .psql : volontairement ignoré par `supabase test db` comme test.
-- Tout est créé DANS la transaction du test, puis annulé (rollback).
-- ============================================================================

set client_min_messages to warning;
create extension if not exists pgtap with schema extensions;
create schema if not exists tests;

-- Les tests ne dépendent pas des données fictives du seed : on vide les tables
-- métier (annulé par le rollback du test). Les comptes du seed restent, sans
-- aucun dossier rattaché.
truncate table public.matters, public.organizations, public.notifications,
               public.client_invitations restart identity cascade;

-- Simule une session : rôle Postgres + claims JWT lus par auth.uid()/auth.jwt().
create or replace function tests.authenticate_as(p_user uuid, p_aal text default 'aal2')
returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims',
    json_build_object('sub', p_user, 'role', 'authenticated', 'aal', p_aal)::text, true);
  perform set_config('role', 'authenticated', true);
end $$;

create or replace function tests.as_anon()
returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
  perform set_config('role', 'anon', true);
end $$;

create or replace function tests.clear_authentication()
returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims', '', true);
  perform set_config('role', 'postgres', true);
end $$;

grant usage on schema tests to anon, authenticated;
grant execute on all functions in schema tests to anon, authenticated;

-- Identifiants fixes (lisibles dans les messages d'échec).
