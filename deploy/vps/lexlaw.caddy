# Serveur de TEST du portail Lex Canada (ADR 0016). Importé par /etc/caddy/Caddyfile
# (`import /etc/caddy/sites/*.caddy`). N'affecte aucun autre site.
lexlaw.2-24-110-184.sslip.io {
	encode zstd gzip

	# Liens de réinitialisation du mot de passe envoyés par Supabase Auth (GET uniquement).
	@verify {
		method GET
		path /auth/v1/verify
	}
	handle @verify {
		reverse_proxy 127.0.0.1:54021
	}

	# Connexion Microsoft du personnel (ADR 0040) : départ vers Microsoft et retour de Microsoft.
	# GET uniquement ; le reste de /auth/v1 reste interne.
	@oauth {
		method GET
		path /auth/v1/authorize /auth/v1/callback
	}
	handle @oauth {
		reverse_proxy 127.0.0.1:54021
	}

	# Boîte d'e-mails de TEST (aucun e-mail réel), protégée par mot de passe.
	# `basicauth` : nom de la directive dans Caddy 2.6 (celui du serveur) ; `basic_auth` à partir de 2.8.
	handle /_mail* {
		basicauth {
			lex __MAIL_HASH__
		}
		reverse_proxy 127.0.0.1:54025
	}

	handle {
		reverse_proxy 127.0.0.1:3100
	}

	log {
		output discard
	}
}
