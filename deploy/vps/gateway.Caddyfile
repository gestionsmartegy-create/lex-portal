# Passerelle interne (remplace Kong) — réseau Docker « lexlaw » uniquement.
{
	admin off
	auto_https off
}

:8000 {
	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}
	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}
	# Gabarits des alertes de sécurité, lus par Supabase Auth.
	handle_path /email/* {
		root * /templates
		file_server
	}
	respond 404
}
