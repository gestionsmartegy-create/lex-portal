# Réglages de Supabase Auth (GoTrue) — mêmes valeurs que supabase/config.toml en local
# (relevées sur le conteneur local de la CLI 2.119). AUCUN secret ici : ils sont dans .env.
GOTRUE_API_HOST=0.0.0.0
GOTRUE_API_PORT=9999
GOTRUE_DB_DRIVER=postgres
GOTRUE_DISABLE_SIGNUP=true
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_EXTERNAL_PHONE_ENABLED=false
GOTRUE_EXTERNAL_ANONYMOUS_USERS_ENABLED=false
GOTRUE_EXTERNAL_AZURE_ENABLED=false
GOTRUE_JWT_ADMIN_ROLES=service_role
GOTRUE_JWT_AUD=authenticated
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
GOTRUE_JWT_EXP=900
GOTRUE_MAILER_AUTOCONFIRM=false
GOTRUE_MAILER_OTP_EXP=3600
GOTRUE_MAILER_SECURE_EMAIL_CHANGE_ENABLED=true
GOTRUE_MFA_MAX_ENROLLED_FACTORS=10
GOTRUE_MFA_TOTP_ENROLL_ENABLED=true
GOTRUE_MFA_TOTP_VERIFY_ENABLED=true
GOTRUE_MFA_PHONE_ENROLL_ENABLED=false
GOTRUE_MFA_PHONE_VERIFY_ENABLED=false
GOTRUE_MFA_WEB_AUTHN_ENROLL_ENABLED=false
GOTRUE_MFA_WEB_AUTHN_VERIFY_ENABLED=false
GOTRUE_PASSWORD_MIN_LENGTH=12
GOTRUE_PASSWORD_REQUIRED_CHARACTERS=abcdefghijklmnopqrstuvwxyz:ABCDEFGHIJKLMNOPQRSTUVWXYZ:0123456789:!@#$$%^&*()_+-=[]{};'\\:"|<>?,./`~
GOTRUE_SECURITY_UPDATE_PASSWORD_REQUIRE_REAUTHENTICATION=true
GOTRUE_SECURITY_REFRESH_TOKEN_ROTATION_ENABLED=true
GOTRUE_SECURITY_REFRESH_TOKEN_REUSE_INTERVAL=10
GOTRUE_SECURITY_MANUAL_LINKING_ENABLED=false
GOTRUE_SESSIONS_TIMEBOX=12h
GOTRUE_RATE_LIMIT_EMAIL_SENT=60
GOTRUE_RATE_LIMIT_VERIFY=30
GOTRUE_RATE_LIMIT_TOKEN_REFRESH=150
GOTRUE_SMTP_HOST=mailpit
GOTRUE_SMTP_PORT=1025
GOTRUE_SMTP_ADMIN_EMAIL=no-reply@lexcanadalaw.test
GOTRUE_SMTP_SENDER_NAME=Lex Canada Law (test)
GOTRUE_SMTP_MAX_FREQUENCY=1s
GOTRUE_MAILER_NOTIFICATIONS_PASSWORD_CHANGED_ENABLED=true
GOTRUE_MAILER_NOTIFICATIONS_EMAIL_CHANGED_ENABLED=true
GOTRUE_MAILER_NOTIFICATIONS_MFA_FACTOR_ENROLLED_ENABLED=true
GOTRUE_MAILER_NOTIFICATIONS_MFA_FACTOR_UNENROLLED_ENABLED=true
GOTRUE_MAILER_NOTIFICATIONS_IDENTITY_LINKED_ENABLED=true
GOTRUE_MAILER_NOTIFICATIONS_IDENTITY_UNLINKED_ENABLED=true
GOTRUE_MAILER_TEMPLATES_PASSWORD_CHANGED_NOTIFICATION=http://gateway:8000/email/password_changed_notification.html
GOTRUE_MAILER_TEMPLATES_EMAIL_CHANGED_NOTIFICATION=http://gateway:8000/email/email_changed_notification.html
GOTRUE_MAILER_TEMPLATES_MFA_FACTOR_ENROLLED_NOTIFICATION=http://gateway:8000/email/mfa_factor_enrolled_notification.html
GOTRUE_MAILER_TEMPLATES_MFA_FACTOR_UNENROLLED_NOTIFICATION=http://gateway:8000/email/mfa_factor_unenrolled_notification.html
GOTRUE_MAILER_TEMPLATES_IDENTITY_LINKED_NOTIFICATION=http://gateway:8000/email/identity_linked_notification.html
GOTRUE_MAILER_TEMPLATES_IDENTITY_UNLINKED_NOTIFICATION=http://gateway:8000/email/identity_unlinked_notification.html
GOTRUE_MAILER_SUBJECTS_PASSWORD_CHANGED_NOTIFICATION=Lex Canada Law — Your password was changed / Votre mot de passe a été modifié
GOTRUE_MAILER_SUBJECTS_EMAIL_CHANGED_NOTIFICATION=Lex Canada Law — Your email address was changed / Votre adresse e-mail a été modifiée
GOTRUE_MAILER_SUBJECTS_MFA_FACTOR_ENROLLED_NOTIFICATION=Lex Canada Law — A two-step verification method was added / Une méthode de vérification en deux étapes a été ajoutée
GOTRUE_MAILER_SUBJECTS_MFA_FACTOR_UNENROLLED_NOTIFICATION=Lex Canada Law — A two-step verification method was removed / Une méthode de vérification en deux étapes a été retirée
GOTRUE_MAILER_SUBJECTS_IDENTITY_LINKED_NOTIFICATION=Lex Canada Law — A sign-in method was linked to your account / Une méthode de connexion a été liée à votre compte
GOTRUE_MAILER_SUBJECTS_IDENTITY_UNLINKED_NOTIFICATION=Lex Canada Law — A sign-in method was removed from your account / Une méthode de connexion a été retirée de votre compte
