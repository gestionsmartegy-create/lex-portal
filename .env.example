# Copier en .env.local et remplir. NE JAMAIS committer de valeur réelle (AGENTS.md §2.1).
# Les variables NEXT_PUBLIC_* sont visibles dans le navigateur : aucun secret.

# --- Supabase (projet ca-central-1) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement — contourne la RLS. Jamais dans une variable NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ---
APP_BASE_URL=
# Secret d'en-tête du planificateur (/api/cron/*) — 32 caractères minimum.
CRON_SECRET=
# Lien public de prise de rendez-vous (une valeur par défaut existe dans lib/env.public.ts).
NEXT_PUBLIC_CLIO_BOOKING_URL=

# --- E-mails (local : Mailpit, généré par pnpm env:local ; préproduction/production : SMTP Microsoft 365, ADR 0013) ---
# Forme : smtp://<boîte>%40lexcanadalaw.com:<mot de passe>@smtp.office365.com:587 (STARTTLS imposé) — saisie dans Vercel uniquement.
SMTP_URL=
EMAIL_FROM=

# --- Connexion Microsoft du personnel : true seulement après configuration Azure (ADR 0010) ---
NEXT_PUBLIC_STAFF_SSO_ENABLED=false
# Seulement si l'application parle à Supabase par une adresse interne (serveur de test, ADR 0040) :
# adresse publique de Supabase Auth pour le départ vers Microsoft. Vide ailleurs.
SUPABASE_PUBLIC_URL=

# --- Mode des intégrations : mock (défaut) | live ---
INTEGRATION_MODE_CLIO=mock
INTEGRATION_MODE_SHAREPOINT=mock
INTEGRATION_MODE_SIGNATURE=mock
INTEGRATION_MODE_PAYMENTS=mock
INTEGRATION_MODE_MALWARE=mock
INTEGRATION_MODE_OUTLOOK=mock
INTEGRATION_MODE_AI=mock

# --- Clio Manage, région CA (Phase 2, ADR 0013) — serveur uniquement ---
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=

# Nombre de proxys de confiance devant l'application (x-forwarded-for, ADR 0010) : 1 par défaut.
# Vercel remplace x-forwarded-for par l'IP réelle du client : garder 1 (ADR 0013).
TRUSTED_PROXY_HOPS=1
